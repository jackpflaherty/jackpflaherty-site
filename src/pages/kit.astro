---
// The rebooking page (SpeakrBrand Filter rule 8): one button per item at a URL Jack can say on a phone call.
// The bio here is the canonical bio; every program, listing and show note points at it from now on.
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const page = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  '@id': site.url + '/kit', url: site.url + '/kit',
  name: 'Speaker kit: Jack P. Flaherty',
  description: 'Everything a planner needs to introduce, promote and stage Jack P. Flaherty: bios, keynotes, book, reel, photos and stage intro.',
  about: { '@id': site.url + '/#person' }
};
const items = [
  { id: 'bio', label: 'Bios' },
  { id: 'keynotes', label: 'Keynotes' },
  { id: 'intro', label: 'Stage intro' },
  { id: 'reel', label: 'Reel and video' },
  { id: 'photos', label: 'Photos' },
  { id: 'book', label: 'The book' },
  { id: 'proof', label: 'Testimonials' },
  { id: 'contact', label: 'Contact' }
];
const photos = [
  { f: 'jack-p-flaherty-keynote-speaker-hero.jpg', o: 'Horizontal', d: 'Office, waist up' },
  { f: 'jack-p-flaherty-keynote-stage-wide.jpg', o: 'Horizontal', d: 'On stage, wide' },
  { f: 'jack-p-flaherty-decision-switch-stage-bw.jpg', o: 'Horizontal', d: 'On stage, black and white' },
  { f: 'jack-p-flaherty-portrait-about.jpg', o: 'Vertical', d: 'Portrait' },
  { f: 'jack-p-flaherty-portrait-pier.jpg', o: 'Vertical', d: 'Portrait, outdoors' },
  { f: 'jack-p-flaherty-portrait-square.jpg', o: 'Square', d: 'Headshot' }
];
---
<Base title="Speaker Kit | Jack P. Flaherty" description="Everything a planner needs to introduce, promote and stage Jack P. Flaherty: bios, keynotes, book, reel, photos and stage intro." path="/kit" schema={[page]}>

  <section class="tight">
    <div class="wrap">
      <p class="kicker">Speaker kit</p>
      <h1>Everything you need to introduce, promote and stage Jack P. Flaherty</h1>
      <p class="lede">One button per item. Grab what you need and forward the rest. Questions to <a href={`mailto:${site.email}`}>{site.email}</a>; Jack replies within one business day.</p>
      <nav class="kit-nav" aria-label="Kit contents">
        {items.map(i => <a class="btn light" href={'#' + i.id}>{i.label}</a>)}
      </nav>
    </div>
  </section>

  <section id="bio">
    <div class="wrap">
      <h2>Bios</h2>
      <p class="meta">Use as written. If a form needs a different length, cut from the end.</p>
      <div class="grid c2">
        <div class="card">
          <h3>Short, 50 words</h3>
          <p>Jack P. Flaherty is the trusted advisor who helps boards and executives make decisions with technology. A former Big 4 director with 25 years in risk and advisory, he delivers two keynotes, Fear Is Not The Control and The Decision Switch, and is the author of The Decision Switch.</p>
        </div>
        <div class="card">
          <h3>Full, 100 words</h3>
          <p>Jack P. Flaherty is the trusted advisor who helps boards and executives make decisions with technology. For 25 years in risk and advisory, 15 of them at the Big 4, he sat in the rooms where technology decisions were made, defended and paid for. He served as acting enterprise risk and audit leader for a $10B health system and led a board-mandated cybersecurity program for a $4B health system. He delivers two keynotes, Fear Is Not The Control, for health-system leaders and professional services partners, and The Decision Switch, the original. He wrote The Decision Switch and lives in Los Angeles.</p>
        </div>
      </div>
      <p class="meta" style="margin-top:1rem">Name on every program and slide: Jack P. Flaherty. Title: Keynote speaker and trusted advisor.</p>
    </div>
  </section>

  <section class="dark" id="keynotes">
    <div class="wrap">
      <h2>Keynotes</h2>
      {/* Keynotes copy is taken from the keynote hub, build prompt v1.3 (Nov 5 2026). */}
      <p class="lede" style="color:#E3D5BE">Two keynotes on governing how your people use AI.</p>
      <div class="grid c2" style="margin-top:1.5rem">
        <div class="card">
          <p class="kicker">Boards, C-suite teams, managing partners, PE and VC sponsors, and leaders in healthcare and financial services.</p>
          <h3>Fear Is Not The Control</h3>
          <p><strong>The Hard Questions.</strong> Governing How Your People Use AI. Versions for Boards &amp; C-Suite, Professional Services, and Regulated Industries: Healthcare &amp; Financial Services.</p>
          <p><strong>Gain</strong> a one-page owner map of how your people use AI today, built on the NIST AI RMF and ISO/IEC 42001.</p>
          <p>Keynote 45 to 60 min. Board briefing 90 min.</p>
          <p><a href="/keynotes#fear-is-not-the-control">Full description</a></p>
        </div>
        <div class="card">
          <p class="kicker">Executive teams, nurse leaders, founders and owners, PE and VC sponsors, and association and conference general sessions.</p>
          <h3>The Decision Switch</h3>
          <p><strong>Set the Direction. Stay on It.</strong> Versions for Healthcare &amp; Nursing, Entrepreneurs, PE &amp; VC, and Associations &amp; Conference Audiences.</p>
          <p><strong>Gain</strong> a one-page decision record your team can use Monday: the decision, the owner, the goal, and the signal that says check again.</p>
          <p>Keynote 45 to 60 min.</p>
          <p><a href="/keynotes#the-decision-switch">Full description</a></p>
        </div>
      </div>
    </div>
  </section>

  <section id="intro">
    <div class="wrap">
      <h2>Stage intro</h2>
      <p class="meta">Written to be read aloud by a stranger. About 45 seconds.</p>
      <div class="card intro">
        <p>Our next speaker has spent 25 years in the rooms where technology decisions get made, defended and paid for. Fifteen of those years were at the Big 4, where he served as a director. He has been the acting enterprise risk and audit leader for a ten-billion-dollar health system, and he led a board-mandated cybersecurity program for a four-billion-dollar health system that closed its urgent gaps within a year. He wrote the book The Decision Switch, and he is here today with one idea that will change how your organization makes its next call on new technology. His keynote is called Fear Is Not The Control. Please welcome Jack P. Flaherty.</p>
        <p class="meta">For The Decision Switch, swap the last two sentences: "...and he is here today to show you how a leadership team gets a stalled decision made and stands behind it. His keynote is called The Decision Switch. Please welcome Jack P. Flaherty."</p>
      </div>
    </div>
  </section>

  <section class="dark" id="reel">
    <div class="wrap reel">
      <div class="vid"><div class="box"><iframe src={site.reelEmbed} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" title="Jack P. Flaherty speaker reel, The Decision Switch keynote"></iframe></div></div>
      <div>
        <h2>Reel and video</h2>
        <p>Three minutes of Jack on stage, from The Decision Switch keynote. Executive audience, live exercises, the method in use.</p>
        <p><a href={site.reelWatch} target="_blank" rel="noopener">Open on YouTube</a> · <a href={site.youtube} target="_blank" rel="noopener">All videos</a></p>
      </div>
    </div>
  </section>

  <section id="photos">
    <div class="wrap">
      <h2>Photos</h2>
      <p class="meta">High resolution. Free to use for promoting an event Jack is speaking at. Please do not crop the signature out of the stage photos.</p>
      <div class="grid c3 photos">
        {photos.map(p => (
          <a class="card" href={'/images/' + p.f} download>
            <img src={'/images/' + p.f} alt={`Jack P. Flaherty, ${p.d.toLowerCase()}`} loading="lazy" />
            <p><strong>{p.o}.</strong> {p.d}. Click to download.</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="dark" id="book">
    <div class="wrap split">
      <div>
        <h2>The book</h2>
        <h3>The Decision Switch</h3>
        <p>Cinch &amp; Stone Press. The method underneath both keynotes: seven principles that turn a stalled decision into one the team will stand behind. Bulk copies for attendees can be arranged through Jack.</p>
        <p><a href="/books/the-decision-switch">About the book</a> · <a href={site.amazon} target="_blank" rel="noopener">On Amazon</a></p>
      </div>
      <img src="/images/the-decision-switch-book-stack-latte.jpg" alt="The Decision Switch by Jack P. Flaherty, a stack of copies" loading="lazy" style="border-radius:var(--r);max-width:100%" />
    </div>
  </section>

  <section id="proof">
    <div class="wrap">
      <h2>Testimonials</h2>
      <p class="meta">In the speaker's own words. More on the <a href="/press-media">Media page</a>.</p>
      <div class="grid c3">
        <div class="card"><p>“Jack delivers a practical framework to keep you on track and lead you to the best outcomes.”</p><p class="meta"><strong>Charles Todd</strong>, Principal, Deloitte</p></div>
        <div class="card"><p>“Jack brings high energy and dedication, along with a great personality and a sense of humor, which is often helpful when dealing with formal processes and operational change!”</p><p class="meta"><strong>Bill Lazarus</strong>, CTO, UCLA Health</p></div>
        <div class="card"><p>“Jack converts the pain of making tough decisions into the pleasure of achieving your goals, through his proven framework.”</p><p class="meta"><strong>Jason Emmons</strong>, Partner, Baker Tilly</p></div>
      </div>
    </div>
  </section>

  <section class="tight" id="contact">
    <div class="wrap">
      <div class="cta-band">
        <h2>Contact</h2>
        <p>{site.email} · {site.phone} · Los Angeles, California</p>
        <p class="meta">AV requirements, travel details and anything not on this page: ask, and Jack replies within one business day.</p>
        <div class="btns" style="justify-content:center;margin-top:.4rem"><a class="btn" href={site.calendly} target="_blank" rel="noopener">Book a discovery call</a><a class="btn light" href="/book-jack">Send an inquiry</a></div>
      </div>
    </div>
  </section>

</Base>

<style>
  .kit-nav { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.4rem; }
  .kit-nav .btn { padding: .6rem 1rem; font-size: .95rem; background: transparent; color: var(--ink); border-color: var(--ink); }
  .kit-nav .btn:hover { background: var(--ink); color: var(--latte); }
  .intro p:first-child { font-size: 1.15rem; line-height: 1.6; }
  .photos .card { display: block; text-decoration: none; color: inherit; }
  .photos img { aspect-ratio: 4/3; object-fit: cover; width: 100%; border-radius: 6px; margin-bottom: .8rem; }
  .photos p { margin: 0; font-size: .95rem; }
</style>
