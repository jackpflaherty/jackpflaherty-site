---
import Base from '../../layouts/Base.astro';
import AssessmentScore from '../../components/AssessmentScore.astro';
import a from '../../data/assessment.json';
import site from '../../data/site.json';
---
<Base title="Your results | The Clear Confidence Assessment" description="Your Clear Confidence Score, your tier and your lowest dimension."
  path="/assessment/results" canonicalUrl={a.host + a.paths.results} noindex={true} flow={true}>

  <!-- Phone-first results (A5 layout spec, Oct 28 2026): the score, the tier, the three dimensions with the lowest
       marked, one sentence and one button sit in the first screen; the written read follows below it. -->
  <section class="dark hero-score">
    <div class="wrap narrow">
      <p class="kicker">The Clear Confidence Assessment</p>
      <h1><span data-score>--</span> out of 100.</h1>
    </div>
  </section>

  <section class="first">
    <div class="wrap narrow">
      <p class="tierline"><span class="k">Your profile</span> · <span data-tier-label></span></p>
      <AssessmentScore rows={true} />
      <p class="tline" data-tier-line></p>
      <p class="act"><a class="btn" href="#read">Read the direct read</a></p>
    </div>
  </section>

  <section class="read" id="read">
    <div class="wrap narrow">
      <h2 class="hello"><span data-first></span>, here is the direct read on your score.</h2>
      {Object.entries(a.tiers).map(([k, t]) => (
        <div class="tier" id={'tier-' + k} hidden>
          {t.narrative.map(p => <p>{p}</p>)}
        </div>
      ))}
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="grid c2">
        <div class="card">
          <h3>What happens next</h3>
          <p>The written read for your role and industry is on its way to <strong data-email></strong>. It usually arrives within a minute. If it has not, check your spam or promotions folder.</p>
          <p>It covers what your lowest dimension means for someone in your seat, where the gap shows up first, and what it costs if it goes unaddressed.</p>
        </div>
        <div class="card accent">
          <h3>The conversation worth having</h3>
          <p>Thirty minutes with Jack on what the score surfaced and whether it is worth acting on now. No pitch. Either way you leave with a clearer read.</p>
          <p style="margin-top:1rem"><a class="btn" href={site.calendly} target="_blank" rel="noopener">Book a discovery call</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  import { read, render } from '../../scripts/assessment-view';
  import a from '../../data/assessment.json';
  const v = read();
  render(v);
  const t = (a.tiers as Record<string, { line: string }>)[v.tier];
  const tl = document.querySelector<HTMLElement>('[data-tier-line]'); if (tl) tl.textContent = t ? t.line : '';
  if (!v.first) { const h = document.querySelector<HTMLElement>('.hello'); if (h) h.textContent = 'Here is the direct read on your score.'; }
  document.title = 'Your results | Clear Confidence Assessment' + (v.first ? ' | ' + v.first : '');
</script>

<style>
  .hero-score{padding:1rem 0 1.1rem}
  .hero-score .kicker{font-size:.875rem;margin:0 0 .3rem}
  .hero-score h1{font-size:2.5rem;line-height:1.1;margin:0}
  .first{padding:.9rem 0 1.25rem}
  .tierline{font-family:var(--font-head);font-weight:700;font-size:1.25rem;line-height:1.3;margin:0 0 .25rem;color:var(--ink)}
  .tierline .k{color:var(--sienna);font-size:1rem}
  .tline{font-size:1rem;line-height:1.5;color:var(--brown);margin:.9rem 0 0}
  .act{margin:.9rem 0 0}
  .act .btn{display:block;width:100%;text-align:center;padding:.85rem 1rem;min-height:52px}
  .read{padding:1.5rem 0 1rem}
  .read p{font-size:1rem;line-height:1.55}
  .hello{font-family:var(--font-head);font-weight:700;font-size:1.25rem;line-height:1.3;margin:0 0 .9rem}
  .tier[hidden]{display:none}
  .tight p{font-size:1rem}
</style>
