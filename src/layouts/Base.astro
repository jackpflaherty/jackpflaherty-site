---
import '../styles/global.css';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import manifest from '../data/images.json';
interface Props { title: string; description: string; keywords?: string; path: string; image?: string; noindex?: boolean; schema?: object[]; type?: string; hero?: string; heroMobile?: string; canonicalUrl?: string; personDescription?: string; }
// personDescription: the Person schema description for this page. The home page passes the canonical entity
// sentence (Facts Ledger, Search and entity fields); other pages keep the position line until each is rewritten.
const { title, description, keywords = '', path, image = '/images/jack-p-flaherty-keynote-speaker-hero.jpg', noindex = false, schema = [], type = 'website', hero, heroMobile, canonicalUrl, personDescription = site.position } = Astro.props;
// Preload the hero photo (WebP srcset) so the browser fetches it before it parses the body.
const srcsetFor = (p: string) => {
  const n = p.replace(/^\/images\//, ''); const m = (manifest as Record<string, { widths: number[] }>)[n];
  return m ? m.widths.map(w => `/images/r/${n.replace(/\.(jpe?g|png)$/i, '')}-${w}.webp ${w}w`).join(', ') : '';
};
const heroSet = hero ? srcsetFor(hero) : '';
const heroMobileSet = heroMobile ? srcsetFor(heroMobile) : '';
const canonical = canonicalUrl || site.url + (path === '/' ? '/' : path);
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': site.url + '/#person',
  name: 'Jack P. Flaherty', alternateName: 'Jack Flaherty', url: site.url,
  image: site.url + '/images/jack-p-flaherty-portrait-about.jpg',
  jobTitle: 'Keynote speaker and trusted advisor to boards and executives',
  description: personDescription,
  telephone: site.phone, email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Los Angeles', addressRegion: 'CA', addressCountry: 'US' },
  sameAs: [site.linkedin, site.youtube, site.instagram, site.amazon],
  knowsAbout: ['Technology decision-making', 'AI governance', 'Board and audit committee oversight', 'Enterprise risk management', 'Cybersecurity governance', 'Healthcare technology risk'],
  worksFor: { '@id': site.url + '/#organization' }
};
const organization = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': site.url + '/#organization',
  name: 'The Decision Switch', url: site.url,
  logo: site.url + '/images/jack-p-flaherty-signature-logo.png',
  founder: { '@id': site.url + '/#person' },
  address: { '@type': 'PostalAddress', addressLocality: 'Los Angeles', addressRegion: 'CA', addressCountry: 'US' },
  telephone: site.phone, email: site.email,
  sameAs: [site.linkedin, site.youtube, site.instagram]
};
const website = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': site.url + '/#website',
  name: 'Jack P. Flaherty', url: site.url,
  publisher: { '@id': site.url + '/#person' }
};
const all = [person, organization, website, ...schema];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={site.url + image} />
  <meta property="og:site_name" content="Jack P. Flaherty" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/images/favicon-48.png" type="image/png" />
  {heroSet && <link rel="preload" as="image" type="image/webp" imagesrcset={heroSet} imagesizes="100vw" media={heroMobileSet ? '(min-width: 768px)' : undefined} />}
  {heroMobileSet && <link rel="preload" as="image" type="image/webp" imagesrcset={heroMobileSet} imagesizes="100vw" media="(max-width: 767px)" />}
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-KQKGW9HK');</script>
  <link rel="preload" href="/fonts/open-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  {all.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KQKGW9HK" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
