---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="logo" href="/"><img src="/images/jack-p-flaherty-signature-logo-latte.png" alt="Jack P. Flaherty" width="900" height="258" /></a>
        <p>{site.position}</p>
        <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={'mailto:' + site.email}>{site.email}</a><br />Los Angeles, California</p>
      </div>
      <div>
        <h3>Keynotes</h3>
        <ul>
          <li><a href="/keynote-speaker/fear-is-not-a-control">Fear Is Not A Control</a></li>
          <li><a href="/keynote-speaker/the-decision-switch">The Decision Switch</a></li>
          <li><a href="/kit">Speaker kit</a></li>
        </ul>
        <h3>Advisory</h3>
        <ul>
          <li><a href="/keynote-speaker/board-advisor-ai-governance">Board and Executive Advisory</a></li>
        </ul>
        <h3>Audiences</h3>
        <ul>
          <li><a href="/industries/ai-emerging-technology">AI and Emerging Technology</a></li>
          <li><a href="/industries/professional-services-accounting-consulting">Professional Services</a></li>
          <li><a href="/industries/healthcare-providers">Health Systems</a></li>
          <li><a href="/industries/industry-associations">Associations</a></li>
        </ul>
      </div>
      <div>
        <h3>The Clear Confidence Report</h3>
        <p>Practical insight on making decisions with technology. One idea per issue, no filler.</p>
        <form action="/api/inquiry" method="post" data-newsletter>
          <input type="hidden" name="source" value="newsletter" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <label class="sr" for="nl-email">Email address</label>
          <input id="nl-email" type="email" name="email" placeholder="you@organization.com" required />
          <button class="btn" type="submit">Get the Report</button>
        </form>
        <ul style="margin-top:1rem">
          <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={site.youtube} rel="me">YouTube</a></li>
          <li><a href={site.instagram} rel="me">Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} Jack P. Flaherty. All rights reserved. The Decision Switch® is a registered trademark.</span>
      <a href="/privacy">Privacy policy</a>
    </div>
  </div>
</footer>
