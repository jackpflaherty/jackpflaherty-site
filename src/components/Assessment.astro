---
import site from '../data/site.json';
---
<section class="assessment">
  <div class="wrap split top">
    <div>
      <h2>Take the Clear Confidence Assessment</h2>
      <p class="lede">A three-minute read on how your organization makes decisions with technology. Free. No call required.</p>
      <a class="btn" href={site.assessment} target="_blank" rel="noopener">See where you stand</a>
    </div>
    <ul class="checks">
      <li>Your Clear Confidence Score, 0 to 100</li>
      <li>Which of four decision-making tiers you are in</li>
      <li>Your single biggest gap, named</li>
      <li>A personalized report, yours to keep</li>
    </ul>
  </div>
</section>
