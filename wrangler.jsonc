{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jackpflaherty-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Hostnames, as the zone is actually wired (read from the dashboard Oct 27 2026):
  // the apex is this Worker's custom domain; www is a proxied CNAME to the apex served through a
  // zone route; assessment is added as a custom domain by the first deploy after this lands, which
  // creates its DNS record and asks before replacing the existing FlexiFunnels CNAME. Say yes only
  // on Jack's go. The Worker already maps the legacy assessment paths onto the built pages.
  "routes": [
    { "pattern": "jackpflaherty.com", "custom_domain": true },
    { "pattern": "www.jackpflaherty.com/*", "zone_name": "jackpflaherty.com" },
    { "pattern": "assessment.jackpflaherty.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
