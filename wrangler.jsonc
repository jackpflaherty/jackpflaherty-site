{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jackpflaherty-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Custom domains the Worker answers on. www was attached in the dashboard at the Oct 14 cutover;
  // assessment is attached by the first `wrangler deploy` after this lands, which creates its DNS
  // record. That deploy stops and asks before it replaces the existing record (the FlexiFunnels
  // CNAME); say yes only on Jack's go. The Worker already maps the legacy assessment paths.
  "routes": [
    { "pattern": "www.jackpflaherty.com", "custom_domain": true },
    { "pattern": "assessment.jackpflaherty.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
